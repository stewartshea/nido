# Nido deploy configuration
# Copy to `.env` and edit before starting.

# REQUIRED. Encrypts every per-family database (HKDF-SHA256). Generate once and
# keep it safe: change it later and existing databases become undecryptable.
#   openssl rand -hex 32
KAMORI_MASTER_KEY=""

# registry.db, db/<familyId>.db and photos/ live on the nido-data volume.
KAMORI_DATA_DIR="/data"
PHOTO_DIR="/data/photos"

# CHANGE THIS — used to sign JWTs.
JWT_SECRET="change-me-to-a-long-random-string"

# Public origin the web client uses to reach the API. Leave EMPTY so the client
# calls the API same-origin (/api/v1) — the web container's Vite dev server
# proxies /api to the api service. Set only when the API is served from a
# different origin than the web app, e.g. "https://api.example.com".
API_URL=""

# Where the web container's Vite dev server forwards /api/*.
# Inside Compose the api service is reachable at http://api:3000.
API_PROXY_TARGET="http://api:3000"

# Hosts the web (Vite dev server) is allowed to respond to — comma-separated.
# Local use: "localhost". Behind a reverse proxy, add the public domain you
# proxy to the web container, e.g. "nido.example.com".
ALLOWED_HOSTS="localhost"