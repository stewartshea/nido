# Nido deploy configuration
# Copy to `.env` and edit before starting.

# REQUIRED. Encrypts every per-family database (HKDF-SHA256). Generate once and
# keep it safe: change it later and existing databases become undecryptable.
#   openssl rand -hex 32
NIDO_MASTER_KEY=""

# registry.db, db/<familyId>.db and photos/ live on the nido-data volume.
NIDO_DATA_DIR="/data"
NIDO_BLOB_DIR="/data/blobs"

# CHANGE THIS — used to sign JWTs.
JWT_SECRET=""

# Public origin the web client uses to reach the API. Leave EMPTY so the client
# calls the API same-origin (/api/v1) — the web server proxies /api to the api
# service. Set only when the API is served from a different origin than the web
# app, e.g. "https://api.example.com".
API_URL=""

# Where the web server forwards /api/*.
# Inside Compose the api service is reachable at http://api:3000.
API_PROXY_TARGET="http://api:3000"

# --- API logging ---
# The API writes one JSON object per line to stdout, so `docker compose logs -f
# api` and any shipper can read it.
#   debug | info | warn | error | silent  — "info" is the normal setting;
#   "debug" is very noisy and meant for chasing a single request.
LOG_LEVEL="info"
# json | pretty. Unset lets the API choose (json when piped, pretty on a TTY).
# LOG_FORMAT="json"

# --- Notification digests ---
# The API emails each family's newly firing inventory alerts on a timer, so
# nothing has to be open in a browser. Unset means enabled.
# Keep it on for a single API container; if you scale to replicas, set
# NOTIFY_ENABLED="false" on all but one.
# NOTIFY_ENABLED="true"
NOTIFY_INTERVAL_MINUTES="60"