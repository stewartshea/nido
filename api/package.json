    "directory": "api"
  },
  "bugs": {
    "url": "https://github.com/stewartshea/nido/issues"
  },
  "homepage": "https://github.com/stewartshea/nido#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "@hono/zod-validator": "^0.2.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "hono": "^4.0.0",
    "itty-time": "^1.0.6",
