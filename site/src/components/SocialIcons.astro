---
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import { HOSTED_URL, withBase } from '../site.config';

// Hosted option — My Nido, the logged-in SaaS. The docs link out to it in
// several places; the header carries a compact login button too, so a visitor
// who wants to skip reading and just use the app can get in one click.
const HOSTED_LOGIN_URL = `${HOSTED_URL}/login`;

// The landing page is deliberately bare (no in-page links above the carousel),
// so the header is the reliable way to reach the documentation itself — point
// "Docs" at the features page, the richest single survey of the product.
const DOCS_URL = withBase('/features/');

const links = config.social || [];
---

{
	links.length > 0 && (
		<>
			{links.map(({ label, href, icon }) => (
				<a {href} rel="me" class="sl-flex">
					<span class="sr-only">{label}</span>
					{href.includes('ko-fi.com') ? (
						<svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2Zm0 5h-2V5h2v3ZM4 19h16v2H4Z" />
						</svg>
					) : (
						<Icon name={icon} />
					)}
				</a>
			))}
			<a class="header-docs" href={DOCS_URL}>
				Docs
			</a>
			<a class="header-login" href={HOSTED_LOGIN_URL}>
				Log in
			</a>
		</>
	)
}

<style>
	@layer starlight.core {
		a {
			color: var(--sl-color-text-accent);
			padding: 0.5em;
			margin: -0.5em;
		}
		a:hover {
			color: var(--sl-color-white);
		}

		/* "Docs" text link in the header, before the login button. */
		.header-docs {
			display: inline-flex;
			align-items: center;
			margin: 0 0 0 0.5rem;
			padding: 0.35rem 0.6rem;
			font-size: 0.85rem;
			font-weight: 600;
			line-height: 1;
			color: var(--sl-color-text-accent);
			text-decoration: none;
		}

		.header-docs:hover {
			color: var(--sl-color-white);
		}

		/* Compact "Log in" button in the header, right of the social icons. */
		.header-login {
			display: inline-flex;
			align-items: center;
			margin: 0 0 0 0.5rem;
			padding: 0.35rem 0.85rem;
			border: 1px solid var(--sl-color-accent);
			border-radius: 999px;
			font-size: 0.85rem;
			font-weight: 600;
			line-height: 1;
			color: var(--sl-color-accent);
			text-decoration: none;
			transition: background-color 150ms ease, color 150ms ease;
		}

		.header-login:hover {
			background: var(--sl-color-accent);
			color: var(--sl-color-accent-low);
		}
	}
</style>