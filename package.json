    "build": "docker-compose build",
    "start": "docker-compose up -d",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "family",
    "tracking",
    "newborn",
    "infant",
    "parenting",
    "self-hosted"
  ],
