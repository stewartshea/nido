# --- Database (Phase A: per-family encrypted SQLite namespaces) ---

# Master key for SQLCipher-encrypted family databases + the registry.
# Generate once and back it up — family data is unrecoverable without it:
#   openssl rand -hex 32
# Unset in dev -> a loud console.warn + an INSECURE development fallback key.
KAMORI_MASTER_KEY=

# Directory holding the encrypted registry + family namespace databases:
#   <KAMORI_DATA_DIR>/registry.db          (global routing/settings/admin)
#   <KAMORI_DATA_DIR>/db/<familyId>.db     (one encrypted file per family)
# Defaults to ./data (persisted via the compose ./data bind mount).
KAMORI_DATA_DIR=./data

# Authentication
JWT_SECRET=nido-secret-key-change-in-production

# API base URL the browser uses. Leave empty for same-origin (/api/v1) — the
# web Vite dev server proxies /api to API_PROXY_TARGET. Set only for
# cross-origin APIs, e.g. "https://api.example.com".
PUBLIC_API_URL=

# API the web dev server forwards /api to. Compose default http://api:3000
# (separate containers); single-pod k8s uses http://localhost:3000 (shared
# pod loopback).
API_PROXY_TARGET=http://api:3000

# Frontend
FRONTEND_URL=http://localhost:3001

# Hosts the web dev server accepts requests for (comma-separated).
# Leave as localhost for local use; add your public domain (e.g.
# nido.example.com) when fronting the web container with a reverse proxy.
ALLOWED_HOSTS=localhost
# Designates the single platform admin (email of an existing account).
# If unset, the FIRST registered user becomes the platform admin.
# Only the platform admin can reach Account Settings -> Admin.
ADMIN_EMAIL=

# Controls whether new accounts can register.
#   SIGNUP_ENABLED=true   (or unset) -> registration allowed (DB toggle applies)
#   SIGNUP_ENABLED=false                 -> registration blocked; overrides the Admin toggle
# When set, this env var is authoritative and the Admin panel toggle is locked.
SIGNUP_ENABLED=

# Base URL used in emailed links (verify / password reset). Set to your public
# origin, e.g. https://nido.example.com — not localhost — so emailed links
# reach the public site. Defaults to FRONTEND_URL then http://localhost:3001.
PUBLIC_URL=
