    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext ts",
    "test": "vitest",
    "db:init": "tsx scripts/init-db.ts",
    "db:rekey": "tsx scripts/rekey-databases.ts"
